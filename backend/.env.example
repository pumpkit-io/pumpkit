# Authentication
JWT_SECRET_KEY=...
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_ISSUER=pumpkit
JWT_AUDIENCE=pumpkit-api
COOKIE_MAX_AGE_SECONDS=2592000
FERNET_ENCRYPTION_KEY=...
MAGIC_LINK_TOKEN_DURATION_MINUTES=15
MAGIC_LINK_TOKEN_NUM_BYTES=32

# Google
GOOGLE_CLIENT_ID=long-alphanumeric-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/oauth/google/callback
GOOGLE_NONCE_TOKEN_NUM_BYTES=64
GOOGLE_CODE_VERIFIER_TOKEN_NUM_BYTES=64
GOOGLE_COOKIE_MAX_AGE_SECONDS=600
GOOGLE_TOKEN_ENDPOINT_TIMEOUT_SECONDS=30

# Resend
RESEND_API_KEY=re_...
RESEND_NOREPLY_ADDRESS=noreply@pumpkit.io
RESEND_SUPPORT_ADDRESS=support@pumpkit.io

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:5173/billing/success
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:5173/billing/cancelled
STRIPE_BILLING_PORTAL_RETURN_URL=http://localhost:5173/billing

# Billing
# The Plans Pumpkit sells: Stripe price lookup keys as a quoted JSON list, in display order.
BILLING_PLAN_KEYS='["pumpkit_pro_monthly","pumpkit_pro_yearly"]'
# Days of Trial a User's first Subscription starts with (once per User, card required); 0 = no Trial.
BILLING_TRIAL_PERIOD_DAYS=14

# OpenRouter (optional)
OPENROUTER_API_KEY=

# twitterapi.io (optional; adding an Inspiration author needs it)
TWITTERAPI_IO_API_KEY=

# X API (optional; connecting an X account to schedule posts needs it)
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:5173/oauth/x/callback
# How often the publisher process looks for due Scheduled posts (optional; default 30)
PUBLISHER_POLL_INTERVAL_SECONDS=30
# Most Scheduled posts a User may have per UTC calendar month of publish time (optional; default 100)
SCHEDULED_POSTS_MONTHLY_CAP=100

# PostHog (optional)
POSTHOG_ENABLED=false
POSTHOG_PROJECT_API_KEY=
POSTHOG_PERSONAL_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
