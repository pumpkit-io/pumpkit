# Authentication
JWT_SECRET_KEY=...
FERNET_ENCRYPTION_KEY=...
# Optional: the values below are the defaults.
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_ISSUER=pumpkit
JWT_AUDIENCE=pumpkit-api
COOKIE_MAX_AGE_SECONDS=2592000
MAGIC_LINK_TOKEN_DURATION_MINUTES=15
MAGIC_LINK_TOKEN_NUM_BYTES=32

# Sign-up allowlist (optional): comma-separated addresses and @domains; empty lets anyone sign in
SIGN_UP_ALLOWLIST=

# Google (optional; set both or neither, Google sign-in is off without them)
GOOGLE_CLIENT_ID=long-alphanumeric-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
# Optional: defaults to BACKEND_URL/api/v1/oauth/google/callback.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/oauth/google/callback
# Optional: the values below are the defaults.
GOOGLE_NONCE_TOKEN_NUM_BYTES=64
GOOGLE_CODE_VERIFIER_TOKEN_NUM_BYTES=64
GOOGLE_COOKIE_MAX_AGE_SECONDS=600
GOOGLE_TOKEN_ENDPOINT_TIMEOUT_SECONDS=30

# Operator details (optional; set OPERATOR_NAME, OPERATOR_ADDRESS and SUPPORT_EMAIL together, or none of them)
# Without them the Instance shows no company footer, legal pages, Terms notice, Terms at checkout or support link.
OPERATOR_NAME=
OPERATOR_ADDRESS=
SUPPORT_EMAIL=
# Optional company identifiers shown in the footer.
OPERATOR_VAT_ID=
OPERATOR_REA=
OPERATOR_SHARE_CAPITAL=
OPERATOR_PEC=

# SMTP (optional; set SMTP_HOST and EMAIL_FROM together, or neither and Magic links go to the backend log)
# Resend's SMTP server, for example: host smtp.resend.com, username resend, password your Resend API key.
SMTP_HOST=
EMAIL_FROM=
# Optional: starttls (default, port 587), tls (port 465) or none (port 25); SMTP_PORT overrides the port.
SMTP_SECURITY=starttls
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=

# Stripe (optional; set the three keys and BILLING_PLAN_KEYS together, or none of them)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional: default to FRONTEND_URL/billing/success, /billing/cancelled and /billing.
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:5173/billing/success
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:5173/billing/cancelled
STRIPE_BILLING_PORTAL_RETURN_URL=http://localhost:5173/billing

# Billing
# The Plans Pumpkit sells: Stripe price lookup keys as a quoted JSON list, in display order.
BILLING_PLAN_KEYS='["pumpkit_pro_monthly","pumpkit_pro_yearly"]'
# Days of Trial a User's first Subscription starts with (once per User, card required); 0 = no Trial (optional; default 14).
BILLING_TRIAL_PERIOD_DAYS=14

# LLM (optional; writing needs the key). Any OpenAI-compatible endpoint; OpenRouter by default.
LLM_API_KEY=
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_DRAFTING_MODEL=openai/gpt-5.6-luna
# LLM_HUMANIZING_MODEL=openai/gpt-5.6-luna
# LLM_REVISING_MODEL=openai/gpt-5.6-luna

# twitterapi.io (optional; adding an Inspiration author needs it)
TWITTERAPI_IO_API_KEY=

# X API (optional; connecting an X account to schedule posts needs it)
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:5173/oauth/x/callback
# How often the publisher process looks for due Scheduled posts (optional; default 30)
PUBLISHER_POLL_INTERVAL_SECONDS=30
# Most Scheduled posts a User may have per UTC calendar month of publish time (optional; default 100).
# Leave empty for no cap; 0 turns scheduling off.
SCHEDULED_POSTS_MONTHLY_CAP=100

# PostHog (optional). The project key turns on browser analytics and the consent banner;
# backend events and error tracking also need POSTHOG_ENABLED=true.
POSTHOG_ENABLED=false
POSTHOG_PROJECT_API_KEY=
POSTHOG_PERSONAL_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
POSTHOG_UI_HOST=https://eu.posthog.com
