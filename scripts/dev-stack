#!/usr/bin/env bash
# Dev stack contract for this repo: up | down | destroy | url | status | logs [service].
# Drafted from the sdlc dev-stack template; the rules are in that skill's CONTRACT.md.
set -euo pipefail

# Recorded in docs/agents/dev-stack.md; keep the two in step.
PROJECT="pumpkit"
STRATEGY="b"
PROXY_PORT=1355
PROXY_TLS=0
HEALTH_PATH="/api/v1/health"
HEALTH_TIMEOUT=120
# compose.dev.yml passes it to the backend as PUBLIC_URL; .env's own PUBLIC_URL is the production one.
APP_URL_VAR="DEV_PUBLIC_URL"

# Workers that act on the outside world stay off: .env may hold real X, SMTP and PostHog credentials.
safe_mode_env() {
  export PUBLISHER_ENABLED=false
  export SMTP_HOST='' EMAIL_FROM=''
  export POSTHOG_ENABLED=false
}

# Emulators, as "<service> <path that answers 200>".
EMULATORS=("google /.well-known/openid-configuration" "pumpkit-stripe /_emulate" "pumpkit-x /_pumpkit/events")

# compose.emulators.yml hands these to the backend over .env's, so .env's real keys never reach an Emulator.
emulator_env() {
  # Assign before export: export would hide a failed command substitution from set -e.
  GOOGLE_ISSUER=$(emulator_url google)
  GOOGLE_API_URL=$(b_emulator_api_url google)
  STRIPE_API_URL=$(b_emulator_api_url pumpkit-stripe)
  X_AUTHORIZE_URL="$(emulator_url pumpkit-x)/i/oauth2/authorize"
  X_API_URL=$(b_emulator_api_url pumpkit-x)
  export GOOGLE_ISSUER GOOGLE_API_URL STRIPE_API_URL
  export X_AUTHORIZE_URL X_API_URL
  export GOOGLE_CLIENT_ID="pumpkit-dev" GOOGLE_CLIENT_SECRET="pumpkit-dev-secret"
  export STRIPE_SECRET_KEY="sk_test_dev" STRIPE_PUBLISHABLE_KEY="pk_test_dev"
  export STRIPE_WEBHOOK_URL="http://backend:8000/api/v1/stripe/webhook" STRIPE_WEBHOOK_SECRET="whsec_dev"
  export BILLING_PLAN_KEYS='["pumpkit_pro_monthly","pumpkit_pro_yearly"]' BILLING_TOP_UP_KEY="pumpkit_top_up"
}

# Every route change would otherwise rewrite /etc/hosts, which needs root.
export PORTLESS_SYNC_HOSTS=0

ROOT=$(git rev-parse --show-toplevel)
STATE_DIR="$ROOT/.sdlc/dev-stack"
cd "$ROOT"

note() { printf 'dev-stack: %s\n' "$*" >&2; }
die() { note "$*"; exit 1; }

has_portless() { command -v portless >/dev/null; }

# Any HTTP answer counts, so a proxy in either mode is found on its port.
proxy_running() {
  local code
  code=$(curl -s -o /dev/null -m 2 -w '%{http_code}' "http://127.0.0.1:$PROXY_PORT/" || true)
  [ "${code:-000}" != "000" ]
}

ensure_proxy() {
  proxy_running && return 0
  if [ "$PROXY_PORT" -lt 1024 ]; then
    die "no Portless proxy on port $PROXY_PORT, and starting one there needs sudo; rerun the HTTPS upgrade command in docs/agents/dev-stack.md"
  fi
  local tls_flag=--no-tls
  [ "$PROXY_TLS" = 1 ] && tls_flag=--https
  portless proxy start -p "$PROXY_PORT" "$tls_flag" </dev/null >&2 || die "could not start the Portless proxy"
}

# Without Portless, down and destroy still find their names: the Slug rule of the worktrees skill, applied to the branch.
local_host() {
  local branch slug=""
  if [ "$(git rev-parse --absolute-git-dir)" != "$(git rev-parse --path-format=absolute --git-common-dir)" ]; then
    branch=$(git branch --show-current)
    slug=$(printf '%s' "${branch##*/}" | tr '[:upper:]' '[:lower:]' | sed -e 's/[^a-z0-9-]/-/g' -e 's/--*/-/g' -e 's/^-//' -e 's/-$//' | cut -c1-63)
    slug="${slug%-}."
  fi
  printf '%s%s.localhost\n' "$slug" "$PROJECT"
}

# The hostname comes from Portless, so the Slug matches the one portless run derives.
init_names() {
  local got=""
  if has_portless; then
    got=$(portless get "$PROJECT" </dev/null) || die "portless get $PROJECT failed"
    HOST=${got#*://}
    HOST=${HOST%%[:/]*}
  else
    HOST=$(local_host)
  fi
  ROUTE=${HOST%.localhost}
  if [ "$ROUTE" = "$PROJECT" ]; then
    SLUG=""
  else
    SLUG=${ROUTE%".$PROJECT"}
  fi
  # The Main checkout's names carry no slug, so no branch, not even one ending in main, can share them.
  # "-dev" keeps clear of compose.yml's production project, which is plain "pumpkit".
  if [ -n "$SLUG" ]; then
    COMPOSE_PROJECT="$PROJECT-dev-$SLUG"
  else
    COMPOSE_PROJECT="$PROJECT-dev"
  fi
  if [ -n "$got" ] && proxy_running; then
    DEV_URL=$got
  else
    local scheme=http port_part=":$PROXY_PORT"
    [ "$PROXY_TLS" = 1 ] && scheme=https
    if { [ "$PROXY_TLS" = 1 ] && [ "$PROXY_PORT" = 443 ]; } || { [ "$PROXY_TLS" = 0 ] && [ "$PROXY_PORT" = 80 ]; }; then
      port_part=""
    fi
    DEV_URL="$scheme://$HOST$port_part"
  fi
  # Compose files interpolate it on every command, not only on up.
  export "$APP_URL_VAR=$DEV_URL"
  export DEV_STAGED_X_URL="${DEV_URL%%"$HOST"*}${ROUTE%"$PROJECT"}staged-x.$PROJECT.localhost${DEV_URL#*"$HOST"}"
}

# In HTTPS mode, trust the Portless CA for this request only.
curl_ca() {
  local ca="${PORTLESS_STATE_DIR:-$HOME/.portless}/ca.pem"
  case "$DEV_URL" in
    https://*) [ -f "$ca" ] && printf -- '--cacert\n%s\n' "$ca" ;;
  esac
  return 0
}

answers() {
  local args=()
  while IFS= read -r a; do args+=("$a"); done < <(curl_ca)
  curl -fsS -o /dev/null -m 5 ${args[@]+"${args[@]}"} "$1" 2>/dev/null
}

healthy() { answers "$DEV_URL$HEALTH_PATH"; }

emulator_url() { portless get "$1.emulate.$PROJECT" </dev/null || die "portless get $1.emulate.$PROJECT failed"; }

# Usage: wait_emulator <service> <path> <stack service that runs it>.
wait_emulator() {
  local svc=$1 url deadline=$((SECONDS + HEALTH_TIMEOUT))
  url="$(emulator_url "$svc")$2"
  until answers "$url"; do
    "${STRATEGY}_service_alive" "$3" || die "the $svc Emulator exited before it answered; see: scripts/dev-stack logs $3"
    [ "$SECONDS" -ge "$deadline" ] && die "no answer from $url after ${HEALTH_TIMEOUT}s; see: scripts/dev-stack logs $3"
    sleep 1
  done
}

# A malformed entry would poll a broken URL until the timeout, so up refuses it first.
check_emulators() {
  local e
  for e in ${EMULATORS[@]+"${EMULATORS[@]}"}; do
    [[ "$e" =~ ^[a-z0-9-]+\ /[^\ ]*$ ]] || die "EMULATORS entry \"$e\" needs a service and a path that starts with /"
  done
}

wait_healthy() {
  local deadline=$((SECONDS + HEALTH_TIMEOUT))
  until healthy; do
    "${STRATEGY}_alive" || die "the stack exited before it was healthy; see: scripts/dev-stack logs"
    [ "$SECONDS" -ge "$deadline" ] && die "no healthy answer from $DEV_URL$HEALTH_PATH after ${HEALTH_TIMEOUT}s; see: scripts/dev-stack logs"
    sleep 1
  done
}

# Strategy B: Docker Compose behind portless alias, one Compose project per Slug.

B_COMPOSE_FILE="compose.dev.yml"
# Only this script passes it, so a plain compose.dev.yml run never points the backend at an Emulator.
B_EMULATORS_COMPOSE_FILE="compose.emulators.yml"
B_WEB_SERVICE="frontend"
B_WEB_PORT=5173
# An empty host port lets Docker pick a free one on 127.0.0.1, so stacks never collide.
export DEV_WEB_BIND=127.0.0.1: DEV_API_BIND=127.0.0.1: DEV_DB_BIND=127.0.0.1:
# The Compose service built from emulate.Dockerfile. It serves the Nth EMULATORS entry on B_EMULATE_PORT + N - 1.
B_EMULATE_SERVICE="emulate"
B_EMULATE_PORT=4000

# The Compose file reads these on every command, as it does DEV_PUBLIC_URL: the emulate command's --service and --base-url.
b_emulate_env() {
  local e services=""
  for e in ${EMULATORS[@]+"${EMULATORS[@]}"}; do services="$services${services:+,}${e%% *}"; done
  export EMULATE_SERVICES="$services"
  export EMULATE_BASE_URL="${DEV_URL%%"$HOST"*}${ROUTE%"$PROJECT"}{service}.emulate.$PROJECT.localhost${DEV_URL#*"$HOST"}"
}

# The emulators profile keeps plain `docker compose -f compose.dev.yml up` free of Emulators.
b_compose() {
  b_emulate_env
  docker compose -p "$COMPOSE_PROJECT" -f "$ROOT/$B_COMPOSE_FILE" -f "$ROOT/$B_EMULATORS_COMPOSE_FILE" \
    --profile emulators "$@"
}

b_service_alive() { [ -n "$(b_compose ps -q --status running "$1" 2>/dev/null)" ]; }

b_alive() {
  b_service_alive "$B_WEB_SERVICE" || return 1
  [ "${#EMULATORS[@]}" -eq 0 ] || b_service_alive "$B_EMULATE_SERVICE"
}

b_emulator_route() { printf '%s%s.emulate.%s\n' "${ROUTE%"$PROJECT"}" "$1" "$PROJECT"; }

b_emulator_port() {
  local e i=0
  for e in ${EMULATORS[@]+"${EMULATORS[@]}"}; do
    [ "${e%% *}" = "$1" ] && { printf '%s\n' $((B_EMULATE_PORT + i)); return 0; }
    i=$((i + 1))
  done
  die "$1 is not in EMULATORS"
}

b_emulator_api_url() {
  local port
  # A command substitution ignores set -e, so the failure must stop up here.
  port=$(b_emulator_port "$1") || exit 1
  printf 'http://%s:%s\n' "$B_EMULATE_SERVICE" "$port"
}

# down removes the routes up recorded, so an Emulator dropped from EMULATORS in between leaves no route behind.
b_alias() {
  local routes="$STATE_DIR/routes"
  # --force only ever re-points this worktree's own route at its new port.
  portless alias "$1" "$2" --force </dev/null >&2
  grep -qxF "$1" "$routes" 2>/dev/null || printf '%s\n' "$1" >>"$routes"
}

b_refresh_emulator_routes() {
  local e svc port hostport
  for e in "${EMULATORS[@]}"; do
    svc=${e%% *}
    port=$(b_emulator_port "$svc")
    hostport=$(b_compose port "$B_EMULATE_SERVICE" "$port") || die "$B_EMULATE_SERVICE does not publish port $port for $svc"
    b_alias "$(b_emulator_route "$svc")" "${hostport##*:}"
  done
  for e in "${EMULATORS[@]}"; do wait_emulator "${e%% *}" "${e#* }" "$B_EMULATE_SERVICE"; done
}

b_emulators_up() {
  [ "${#EMULATORS[@]}" -gt 0 ] || return 0
  emulator_env
  b_compose up -d --build --wait "$B_EMULATE_SERVICE" >&2 || die "docker compose up $B_EMULATE_SERVICE failed; see: scripts/dev-stack logs $B_EMULATE_SERVICE"
  b_refresh_emulator_routes
}

b_up() {
  b_emulators_up
  # The backend's start.sh migrates; e2e seeds its own User, so there is no seed step.
  b_compose up -d --build --wait >&2 || die "docker compose up failed; see: scripts/dev-stack logs"
  # Compose may recreate the emulator container and change its published ports.
  b_refresh_emulator_routes
  # e2e/backend.ts runs seed scripts in this project when E2E_BASE_URL is this Dev URL.
  printf '%s\n%s\n%s\n' "$DEV_URL" "$COMPOSE_PROJECT" "$DEV_STAGED_X_URL" >"$STATE_DIR/e2e-target"
  local hostport
  hostport=$(b_compose port "$B_WEB_SERVICE" "$B_WEB_PORT") || die "$B_WEB_SERVICE does not publish port $B_WEB_PORT"
  b_alias "$ROUTE" "${hostport##*:}"
  hostport=$(b_compose port staged-x 8000) || die "staged-x does not publish its browser fixture port"
  b_alias "${ROUTE%"$PROJECT"}staged-x.$PROJECT" "${hostport##*:}"
  local deadline=$((SECONDS + HEALTH_TIMEOUT))
  until answers "$DEV_STAGED_X_URL/"; do
    b_service_alive staged-x || die "the staged X fixture exited; see: scripts/dev-stack logs staged-x"
    [ "$SECONDS" -lt "$deadline" ] || die "the staged X fixture did not answer; see: scripts/dev-stack logs staged-x"
    sleep 1
  done
}

b_remove_routes() {
  local r routes="$STATE_DIR/routes"
  portless alias --remove "$ROUTE" </dev/null >/dev/null 2>&1 || true
  [ -f "$routes" ] || return 0
  while IFS= read -r r; do
    portless alias --remove "$r" </dev/null >/dev/null 2>&1 || true
  done <"$routes"
  rm -f "$routes"
}

b_down() {
  b_compose down >&2
  b_remove_routes
}

b_destroy() {
  b_compose down -v --remove-orphans >&2
  b_remove_routes
}

b_logs() { b_compose logs --no-color --tail 200 ${1+"$1"}; }

usage() { printf 'usage: scripts/dev-stack up|down|destroy|url|staged-x-url|status|logs [service]\n' >&2; }

case "${1:-}" in
  up)
    check_emulators
    has_portless || die "portless is not installed; run the Portless section of setup-sdlc"
    ensure_proxy
    init_names
    mkdir -p "$STATE_DIR"
    safe_mode_env
    "${STRATEGY}_up"
    wait_healthy
    printf '%s\n' "$DEV_URL"
    ;;
  down)
    init_names
    "${STRATEGY}_down"
    ;;
  destroy)
    init_names
    "${STRATEGY}_destroy"
    rm -rf "$STATE_DIR"
    ;;
  url)
    init_names
    printf '%s\n' "$DEV_URL"
    ;;
  staged-x-url)
    init_names
    printf '%s\n' "$DEV_STAGED_X_URL"
    ;;
  status)
    init_names
    if "${STRATEGY}_alive" && healthy; then
      echo running
    else
      echo stopped
      exit 3
    fi
    ;;
  logs)
    init_names
    "${STRATEGY}_logs" ${2+"$2"}
    ;;
  *)
    usage
    exit 2
    ;;
esac
