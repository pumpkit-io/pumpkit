# Pumpkit reads every setting from this one file. Run sh scripts/setup.sh to write .env from it,
# or copy it to .env and fill in the required section.
# docs/configuration.md describes each setting.

# Required

# The address Users open. Every URL Pumpkit needs (API, OAuth callbacks, Stripe return pages)
# derives from it. The dev stack (compose.dev.yml) always uses http://localhost:5173.
PUBLIC_URL=http://localhost:8080
# Secrets. Generate each once and keep it: changing FERNET_ENCRYPTION_KEY makes stored X tokens unreadable.
# POSTGRES_PASSWORD and JWT_SECRET_KEY: openssl rand -hex 32
# FERNET_ENCRYPTION_KEY: openssl rand -base64 32 | tr '+/' '-_'
POSTGRES_PASSWORD=
JWT_SECRET_KEY=
FERNET_ENCRYPTION_KEY=
# Writing Posts: an API key for any OpenAI-compatible endpoint, OpenRouter by default.
LLM_API_KEY=
# Adding Inspiration authors: a twitterapi.io API key.
TWITTERAPI_IO_API_KEY=

# The release compose.yml runs: the ghcr.io/pumpkit-io/pumpkit-backend and pumpkit-web image tag.
# Read CHANGELOG.md before changing it.
PUMPKIT_VERSION=0.5.0

# Optional: web server. An http PUBLIC_URL is served as plain HTTP on HTTP_PORT;
# an https one gets an automatic certificate, so on a server set HTTP_PORT=80 and open ports 80 and 443.
# HTTP_PORT=8080
# HTTPS_PORT=443
# The email address for the certificate authority's expiry notices.
# ACME_EMAIL=
# Another proxy in front of the web server: its addresses or CIDR ranges, space-separated, so the
# rate limits see each caller. Also set FORWARDED_ALLOW_IPS if it is not on a private network.
# TRUSTED_PROXIES=
# true lets search engines index the Instance (index,follow and a robots.txt that allows crawling).
# ALLOW_SEARCH_INDEXING=false

# Optional: LLM endpoint. Point writing at another OpenAI-compatible endpoint or other models.
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_SKETCHING_MODEL=openai/gpt-5.6-luna
# LLM_HUMANIZING_MODEL=openai/gpt-5.6-luna
# LLM_REVISING_MODEL=openai/gpt-5.6-luna

# Optional: author lookups. Adding a handle not in the Author directory looks it up on twitterapi.io.
# Lookups each User may run per hour and per day, and the whole Instance per day.
# AUTHOR_LOOKUP_HOURLY_LIMIT=10
# AUTHOR_LOOKUP_DAILY_LIMIT=30
# AUTHOR_LOOKUP_INSTANCE_DAILY_LIMIT=500
# Days a lookup that found no account, or a private one, answers without asking X again.
# AUTHOR_MISS_DAYS=7
# AUTHOR_PRIVATE_MISS_DAYS=1
# Days an add reuses posts any User fetched, instead of fetching them again.
# AUTHOR_POSTS_REUSE_DAYS=7

# Optional: SMTP. Emails Magic links; set SMTP_HOST and EMAIL_FROM together.
# Without it Magic links go to the backend log.
# Resend's SMTP server, for example: host smtp.resend.com, username resend, password your Resend API key.
# SMTP_HOST=
# EMAIL_FROM=
# starttls (default, port 587), tls (port 465) or none (port 25); SMTP_PORT overrides the port.
# SMTP_SECURITY=starttls
# SMTP_PORT=
# SMTP_USERNAME=
# SMTP_PASSWORD=

# Optional: Sign-up allowlist. Comma-separated addresses and @domains that may sign in.
# Without it anyone can sign in.
# SIGN_UP_ALLOWLIST=

# Optional: Google sign-in. Set both, or neither and Users sign in with a Magic link only.
# Register PUBLIC_URL/api/v1/oauth/google/callback as the OAuth client's redirect URI.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional: Gravatar. true fills an empty Photo from Gravatar on Magic link sign-in,
# sending Gravatar a hash of the User's email address.
# GRAVATAR_ENABLED=false

# Optional: X app. Connecting an X account to schedule and publish Posts needs both.
# Register PUBLIC_URL/oauth/x/callback as the X app's callback URL.
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# false keeps the publisher running without publishing; Scheduled posts wait until it is true again.
# PUBLISHER_ENABLED=true
# How often the publisher looks for due Scheduled posts, in seconds.
# PUBLISHER_POLL_INTERVAL_SECONDS=30
# Most X posts (each Part of a Thread is one) a User may have per Allowance period with Plans, else per UTC calendar month;
# a Trial gets a quarter. Empty for no cap, 0 turns scheduling off.
# X_POSTS_MONTHLY_CAP=100
# How many of those X posts may contain a link, counted the same way; empty for no cap.
# X_LINK_POSTS_MONTHLY_CAP=10

# Optional: Stripe billing. Sells Plans; set the three keys and BILLING_PLAN_KEYS together,
# or none and every User may use all of Pumpkit without a Subscription.
# Point the Stripe webhook at PUBLIC_URL/api/v1/stripe/webhook.
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
# The Plans on sale: Stripe price lookup keys as a quoted JSON list, in display order.
# BILLING_PLAN_KEYS='["pumpkit_pro_monthly","pumpkit_pro_yearly"]'
# Days of Trial a User's first Subscription starts with; 0 turns Trials off.
# BILLING_TRIAL_PERIOD_DAYS=7
# Generations (starting a Post or giving Feedback) per Allowance period, with Plans only; a Trial gets a quarter. Empty for no cap.
# GENERATIONS_MONTHLY_CAP=500
# The Top-up's one-off price lookup key; unset sells no Top-ups.
# BILLING_TOP_UP_KEY=pumpkit_top_up

# Optional: support address. Where the support link opens a new email; without it the link is hidden.
# SUPPORT_EMAIL=

# Optional: Operator details. Shows the company line in the footer, legal pages and Terms at
# checkout; set OPERATOR_NAME with SUPPORT_EMAIL. OPERATOR_VAT_ID adds the VAT ID to the footer.
# OPERATOR_NAME=
# OPERATOR_VAT_ID=

# Optional: PostHog. The project key turns on browser analytics behind the consent banner;
# backend events and error tracking also need POSTHOG_ENABLED=true.
# POSTHOG_PROJECT_API_KEY=
# POSTHOG_ENABLED=false
# POSTHOG_PERSONAL_API_KEY=
# POSTHOG_HOST=https://eu.i.posthog.com
# true relays PostHog through PUBLIC_URL/ph-relay, past adblockers; then set POSTHOG_HOST=PUBLIC_URL/ph-relay.
# POSTHOG_RELAY=false
# POSTHOG_UI_HOST=https://eu.posthog.com

# Optional: external Postgres. The defaults reach the bundled database.
# For another one, set these and COMPOSE_FILE=compose.yml:compose.external-db.yml to drop the bundled db.
# COMPOSE_FILE=compose.yml
# POSTGRES_USER=postgres
# POSTGRES_HOST=db
# POSTGRES_PORT=5432
# POSTGRES_DB=postgres
# require for a managed Postgres that needs SSL.
# POSTGRES_SSL=disable

# Optional: Instance tunables.
# APP_NAME=Pumpkit
# LOG_LEVEL=INFO

# Development only (compose.dev.yml sets ENV=local itself).
# Treat every route as authenticated in the Vite dev server; ignored in production builds.
# VITE_BYPASS_AUTH=false
