# The web image's Caddyfile. start.d/10-site-address.sh derives SITE_ADDRESS and
# ACME_EMAIL_OPTION and TRUSTED_PROXIES_OPTION from PUBLIC_URL, ACME_EMAIL and TRUSTED_PROXIES
# when the container starts.
{
	{$ACME_EMAIL_OPTION}
	{$TRUSTED_PROXIES_OPTION}
}

{$SITE_ADDRESS} {
	encode zstd gzip

	# Media uploads, the web app's and AI apps' upload links: up to a 512 MB video and its first frame.
	# No read_timeout: it counts while the body is still arriving, so it would cut a slow upload.
	@media_uploads path_regexp ^/api/v1/(posts/[^/]+/text/parts/[^/]+/media|scheduled-posts/[^/]+/parts/[^/]+/media|media-uploads/[^/]+)$
	handle @media_uploads {
		request_body {
			max_size 520MiB
		}
		reverse_proxy backend:8000 {
			transport http {
				response_header_timeout 5m
			}
		}
	}

	handle /api/* {
		# Far above any JSON body Pumpkit takes.
		request_body {
			max_size 10MiB
		}
		reverse_proxy backend:8000 {
			# Planning a Brief and writing Feedback's Version answer in one response; allow minutes.
			transport http {
				response_header_timeout 5m
				read_timeout 5m
			}
		}
	}

	# OAuth discovery for MCP clients, including the OpenID path so it answers 404 and not the SPA.
	@oauth_discovery path /.well-known/oauth-authorization-server* /.well-known/oauth-protected-resource* /.well-known/openid-configuration*
	handle @oauth_discovery {
		reverse_proxy backend:8000
	}

	# Optional routes that start.d steps turn on, such as the PostHog relay.
	import /etc/caddy/site.d/*.caddy

	# SPA: fall back to index.html for client routes.
	handle {
		root * /srv

		# Hashed build assets are content-addressed, so they cache forever.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"

		# index.html and SPA routes always revalidate, so an upgrade shows up at once.
		@html not path /assets/*
		header @html Cache-Control "no-cache"

		# No site may frame the consent page, so none can trick a click on Allow.
		@consent path /oauth/consent*
		header @consent X-Frame-Options DENY
		header @consent Content-Security-Policy "frame-ancestors 'none'"

		try_files {path} /index.html
		file_server
	}
}
