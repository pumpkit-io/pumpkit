# Copy to deploy.env (git-ignored) and fill in. Read by scripts/deploy.sh.
# Values must not contain single quotes.
PUBLIC_URL=https://example.com
DOMAIN=example.com
ACME_EMAIL=ops@example.com
SSH_HOST=pumpkit-prod
BRANCH=main
APP_USER=pumpkit
APP_DIR=/home/pumpkit/app
SERVICE_NAME=pumpkit-backend.service

# Optional: create a PostHog annotation per deploy
POSTHOG_PROJECT_ID=
POSTHOG_API_HOST=https://eu.posthog.com
# POSTHOG_PERSONAL_API_KEY=
